# Secrets & env
.env
*.local

# Go
/backend/bin/
*.test
*.out
# Built command binaries (produced by `go build ./cmd/...` in backend/)
/backend/fleetctl
/backend/fleetd
/backend/fleet-enroll-agent

# Node
node_modules/
/frontend/dist/
.vite/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Runtime data
/data/
recordings/
*.log

# Volume backups (make backup-volumes)
/volume-backups/
*.tar.gz

# Python
__pycache__/
*.pyc

# Release artifacts and signing keys. A .fleetup is ~300 MB of build output, and
# a release key is the trust anchor for in-UI upgrades — neither belongs in git.
*.fleetup
release.key
*.release.key
