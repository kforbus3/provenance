# The privileged upgrade sidecar. Builds the tiny prov-updater binary, then runs it on
# docker:cli (Docker CLI + compose plugin) so it can `docker load` and `docker compose
# up` the new images over the mounted /var/run/docker.sock. Deliberately minimal — this
# is the one component that holds Docker access, and it independently re-verifies every
# bundle's signature before acting.
FROM golang:1.26-alpine AS build
WORKDIR /src
ENV GOFLAGS=-mod=mod
COPY go.mod ./
COPY go.sum* ./
RUN go mod download || true
COPY . .
RUN go mod tidy
# RELEASE_TRUST_KEYS optionally bakes the publisher's release public key into the
# binary (comma-separated base64), so trust does not depend solely on env config.
ARG RELEASE_TRUST_KEYS=
RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags "-s -w -X github.com/provenance/backend/internal/release.embeddedTrustKeys=${RELEASE_TRUST_KEYS}" \
      -o /out/prov-updater ./cmd/prov-updater

FROM docker:29-cli
# Ensure the compose plugin is present (the updater shells out to `docker compose`).
RUN apk add --no-cache docker-cli-compose
COPY --from=build /out/prov-updater /usr/local/bin/prov-updater
EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/prov-updater"]
