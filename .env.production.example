# Provenance — PRODUCTION / internet-exposed configuration.
#
# Copy to .env and fill in. This profile assumes the app sits BEHIND a reverse
# proxy (Nginx Proxy Manager) that terminates TLS with a Let's Encrypt cert and
# forwards to the backend over the internal Docker network. Only port 443 of the
# proxy should be reachable from the internet — never publish 8080/5173/Postgres/
# Redis/jumphost/WireGuard. See docs/internet-exposure.md.
#
# IMPORTANT: this file holds every master secret (JWT, CA, vault, backup passphrases,
# DB + updater tokens). After copying to .env, lock it down:
#     chmod 600 .env && chown <deploy-user> .env
# so no other local user on the Docker host can read your keys.

# --- Runtime ---
PROV_ENV=production
PROV_PUBLIC_URL=https://provenance.example.com   # MUST match the public HTTPS URL

# --- Secrets (generate: `openssl rand -hex 32`). Never commit real values. ---
PROV_JWT_SECRET=
PROV_CSRF_SECRET=
PROV_CA_PASSPHRASE=
PROV_VAULT_PASSPHRASE=            # REQUIRED to use the credential vault; MUST differ from CA passphrase
PROV_BACKUP_PASSPHRASE=          # REQUIRED for backups; MUST differ from CA passphrase
PROV_AUDIT_HMAC_KEY=             # REQUIRED (>=32B): keys the tamper-evident audit-log chain; boot fails without it
PROV_ANSIBLE_RUNNER_TOKEN=       # REQUIRED (>=16B): authenticates the backend to the ansible-runner sidecar (must match it)
PROV_RECORDING_KEY=              # RECOMMENDED (>=32B): encrypts session recordings at rest; unset = stored UNENCRYPTED
POSTGRES_PASSWORD=
# Optional: Ansible connection/become-prompt timeout in seconds (default 30). The
# default rides out a momentary overlay-network blip (one TCP retransmission backoff
# cycle) that would otherwise fail a host mid-run; raise it for very-high-latency links.
# PROV_ANSIBLE_TIMEOUT=30

# Optional: dedicate a key for encrypting TOTP secrets at rest, decoupled from
# PROV_JWT_SECRET so the JWT secret can be rotated without re-enrolling MFA. If set on
# an existing deployment, previously-stored MFA secrets keep working (legacy fallback).
# PROV_MFA_ENCRYPTION_KEY=

# --- Multi-tenancy (MSP mode) ---
# If you enable this, PROV_DATABASE_URL MUST connect as a NON-superuser role created
# WITH NOBYPASSRLS, or the app refuses to start (a superuser bypasses row-level security
# and would break tenant isolation). See docs/multi-tenancy.
# PROV_MULTI_TENANCY=true

# --- Database TLS ---
# The compose default connects to the co-located Postgres over the internal Docker
# network with sslmode=disable (acceptable only because the DB is on the same host).
# For ANY networked or managed Postgres, set an explicit URL with TLS — otherwise the
# DB password and every decrypted row cross the network in cleartext. The backend logs
# a warning at boot when sslmode=disable is used.
# PROV_DATABASE_URL=postgres://prov:PASSWORD@db.example.com:5432/prov?sslmode=verify-full&sslrootcert=/etc/prov/pg-ca.crt

# --- Cookies / TLS ---
# REQUIRED behind HTTPS: marks auth cookies Secure so they never leak over HTTP.
PROV_COOKIE_SECURE=true

# --- Session lifetime (tighter than dev) ---
PROV_SESSION_IDLE_TTL=15m
PROV_SESSION_ABSOLUTE_TTL=8h
PROV_REFRESH_TOKEN_TTL=168h        # 7 days (vs 30d default)
PROV_USER_CERT_TTL=168h

# --- Per-IP rate limiting (bot/abuse defense). Tune to your user base. ---
PROV_RATE_LIMIT_PER_MIN=600
PROV_RATE_LIMIT_BURST=120
PROV_AUTH_RATE_LIMIT_PER_MIN=15
PROV_AUTH_RATE_LIMIT_BURST=8

# --- Bootstrap: disable once the first super admin exists. The endpoint also
# self-seals when any user is present, but set this to false as belt-and-braces.
PROV_ALLOW_BOOTSTRAP=false

# --- WebAuthn / passkeys: RPID must be the registrable domain of PUBLIC_URL.
PROV_WEBAUTHN_RPID=provenance.example.com
PROV_WEBAUTHN_ORIGINS=https://provenance.example.com

# --- SSH gateway: pin jump-host key verification in production. ---
PROV_JUMP_HOST=jumphost:22
PROV_JUMP_USER=prov
# PROV_JUMP_KNOWN_HOSTS=/etc/prov/known_hosts   # mount a known_hosts file

# --- WireGuard endpoint reachable by managed hosts (public IP/DNS + port). ---
PROV_WG_JUMP_ENDPOINT=vpn.example.com:51820
