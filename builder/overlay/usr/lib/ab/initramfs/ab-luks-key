#!/bin/sh
# Put this machine's LUKS bootstrap key where crypttab expects it.
#
# The key lives on the BOOT partition rather than inside the image, because an
# update replaces the root slot *and* the initramfs generated from it. A key
# baked into the image is the builder's key, not this machine's: installing a
# bundle built from a different image used to give slot B an initramfs whose
# keyfile opened nothing here, and the machine came up as
#
#   No key available with this passphrase.
#   cryptsetup: ERROR: luks-rootfs-a: maximum number of tries exceeded
#   ALERT!  LABEL=rootfs-b does not exist.  Dropping to a shell!
#
# BOOT is shared by both slots and is not part of a bundle, so the key there is
# the machine's own and survives every update.
#
# init-premount, not local-top. cryptroot is itself a local-top script and
# initramfs-tools orders those by declared prereqs -- which cryptroot does not
# declare for us, and could not. Every init-premount script runs before every
# local-top script, so this is an ordering guarantee rather than a hope.
#
# Failure here is deliberately not fatal: cryptsetup falls back to prompting for
# the passphrase, which is a bad night for whoever is on console but is strictly
# better than an initramfs shell. Every path says why, because the alternative
# is a machine that asks for a password no one knew it wanted.

PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
    prereqs) prereqs; exit 0;;
esac

# One script, two initramfs harnesses. initramfs-tools provides
# log_warning_msg from /scripts/functions; dracut provides warn from
# /lib/dracut-lib.sh. Whichever is present is used, and if neither is, the
# message still reaches the console -- every path here is a fallback to a
# passphrase prompt, and a fallback nobody is told about is the bad night.
if [ -r /scripts/functions ]; then
    . /scripts/functions
elif [ -r /lib/dracut-lib.sh ]; then
    . /lib/dracut-lib.sh
    log_warning_msg() { warn "$@"; }
else
    log_warning_msg() { echo "ab-luks-key: $*" >&2; }
fi

# dracut keeps the crypttab it generated at /etc/crypttab inside the initramfs;
# initramfs-tools puts the cryptroot copy at /cryptroot/crypttab. Look for
# whichever exists rather than assuming, because "no crypttab" and "a crypttab
# somewhere else" both look like an unencrypted image from here -- and the
# second one would skip fetching a key that is genuinely needed.
CRYPTTAB=/cryptroot/crypttab
[ -f "$CRYPTTAB" ] || CRYPTTAB=/etc/crypttab

DEST=/cryptkey/luks.key
# Spelled out rather than derived with `dirname`. The parent of a constant path
# is a constant, and dracut's initramfs has no dirname -- so deriving it made
# every unlock fail with "dirname: command not found", an empty mkdir, no
# keyfile, and a passphrase prompt on a machine meant to boot unattended.
DESTDIR=/cryptkey
MNT=/ab-bootpart

# Nothing to do on an unencrypted image, or once tpm2/tang enrollment has reaped
# the bootstrap key and rewritten crypttab to use clevis.
[ -f "$CRYPTTAB" ] || exit 0
grep -q "$DEST" "$CRYPTTAB" 2>/dev/null || exit 0

mkdir -p "$MNT" "$DESTDIR"
chmod 0700 "$DESTDIR"

# By label, like everything else here: the partition number differs between the
# BIOS and UEFI layouts, and a machine imaged from one must not depend on the
# other. blkid rather than a udev symlink, for the same reason crypttab uses
# PARTLABEL= -- udev may not have settled this early.
# Waited for, not merely looked for.
#
# This runs before any cryptsetup unit, which is the whole point -- a volume
# that is not the root slot is asked for its key exactly once, and a key staged
# after that is a key staged too late. But running that early means the disks may
# not be enumerated yet: systemd-udev-trigger STARTS the coldplug and does not
# wait for it to finish, so the first blkid can legitimately find nothing on a
# machine that is perfectly healthy.
#
# That is exactly what happened. The unit ran at the right moment, found no BOOT
# partition, and fell through to a passphrase prompt on a machine whose key was
# sitting on a partition that appeared a second later.
#
# So: poll. Cheap, bounded, and it fails in the honest direction -- if the
# partition never appears the prompt is still there, and the timeout is short
# enough that a genuinely missing BOOT costs seconds rather than a hung boot.
find_bootdev() {
    blkid -l -t LABEL=BOOT -o device 2>/dev/null && return 0
    blkid -l -t PARTLABEL=BOOT -o device 2>/dev/null && return 0
    # Cache-free retry. blkid answers from /run/blkid/blkid.tab when it exists,
    # and an entry written before a label was applied hides that label
    # afterwards -- a real failure mode wherever something scanned the disk
    # earlier in the same boot. -c /dev/null probes the devices themselves.
    blkid -c /dev/null -t LABEL=BOOT -o device 2>/dev/null | head -1 | grep . && return 0
    blkid -c /dev/null -t PARTLABEL=BOOT -o device 2>/dev/null | head -1 | grep . && return 0
    return 1
}

BOOTDEV=""
_waited=0
while [ "$_waited" -lt 30 ]; do
    BOOTDEV="$(find_bootdev)"
    [ -n "$BOOTDEV" ] && break
    # Nudge udev along rather than only waiting on it, where it is available.
    [ "$_waited" = 0 ] && command -v udevadm >/dev/null 2>&1 && \
        udevadm settle --timeout=10 >/dev/null 2>&1
    sleep 1
    _waited=$((_waited + 1))
done
[ -n "$BOOTDEV" ] && [ "$_waited" -gt 0 ] && \
    echo "ab-luks-key: BOOT appeared after ${_waited}s" >&2

if [ -z "$BOOTDEV" ]; then
    log_warning_msg "ab-luks-key: cannot find the BOOT partition;" \
                    "falling back to a passphrase prompt"
    exit 0
fi

if ! mount -t ext4 -o ro "$BOOTDEV" "$MNT" 2>/dev/null; then
    log_warning_msg "ab-luks-key: cannot mount $BOOTDEV; falling back to a passphrase prompt"
    exit 0
fi

if [ -f "$MNT/ab-keys/luks.key" ]; then
    cp "$MNT/ab-keys/luks.key" "$DEST"
    chmod 0400 "$DEST"
else
    log_warning_msg "ab-luks-key: no key at ab-keys/luks.key on $BOOTDEV;" \
                    "falling back to a passphrase prompt"
fi

umount "$MNT" 2>/dev/null || true
exit 0
